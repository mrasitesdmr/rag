#let terim(ad, tanim) = block(above: 0.7em, below: 0.7em, breakable: false)[*#ad:* #tanim]

= Terimler sözlüğü <bolum-sozluk>
Rehberde geçen bankacılık terimleri alfabetik sırayla aşağıdadır. Parantez içindeki atıflar, terimin ayrıntılı anlatıldığı başlığı gösterir.

#terim[Akdi faiz][Kredi kartı borcunun son ödeme tarihinde tamamı ödenmediğinde kalan borca ya da nakit avansa sözleşmeye göre uygulanan faiz (#bkz(<asgari-odeme>)).]
#terim[Altın hesabı][Altın birikiminin gram cinsinden tutulduğu mevduat hesabı (#bkz(<altin-hesabi>)).]
#terim[Asgari ödeme tutarı][Kredi kartı dönem borcunun, gecikmeye düşmemek için son ödeme tarihine kadar ödenmesi gereken en düşük kısmı (#bkz(<asgari-odeme>)).]
#terim[Banka kartı][Vadesiz hesaba bağlı çalışan, harcama ve nakit çekim tutarı doğrudan hesaptaki paradan düşülen kart (#bkz(<banka-karti>)).]
#terim[Bloke][Bir tutarın hesapta ayrılarak geçici olarak kullanıma kapatılması; örneğin fon alım talimatında ya da otel ödemelerinde (#bkz(<fonlar>)).]
#terim[Borcu yoktur yazısı][Kredinin tamamen ödendiğini gösteren banka yazısı (#bkz(<kredi-kapanis>)).]
#terim[BSMV][Banka ve Sigorta Muameleleri Vergisi. Banka ücretlerine ve tüketici kredilerinin faizine eklenen vergi (#bkz(<kredi-faiz-vergi>)).]
#terim[Cayma hakkı][Kredi sözleşmesinden, onaydan sonraki 14 gün içinde gerekçe göstermeden vazgeçme hakkı (#bkz(<cayma>)).]
#terim[Cepten Cebe][Raşit Bankası'nda hesabı olmayan birine, ATM'den kodla çekilmek üzere para gönderme hizmeti (#bkz(<transfer-limit-ucret>)).]
#terim[Dain-i mürtehin][Sigorta poliçesinde, tazminattan önce alacağını alma hakkı bulunan taraf; krediye bağlı poliçelerde Raşit Bankası (#bkz(<kredi-sigorta>)).]
#terim[DASK][Zorunlu deprem sigortası. Konut kredisinde zorunludur (#bkz(<kredi-sigorta>)).]
#terim[Dönem borcu][Kredi kartının bir hesap kesim döneminde ödenmesi gereken toplam borcu (#bkz(<ekstre>)).]
#terim[Döviz satış kuru][Bankanın döviz sattığı kur; Türk lirasıyla döviz alırken ve döviz cinsinden ücretlerin çevrilmesinde uygulanır (#bkz(<doviz-alim>)).]
#terim[Efektif][Döviz banknotu. Şubelerde döviz hesabına yatırılır ya da çekilir (#bkz(<doviz-hesabi>)).]
#terim[EFT][Elektronik Fon Transferi. Başka bankadaki hesaba iş günlerinde 09.00-17.00 arasında yapılan transfer (#bkz(<eft>)).]
#terim[Ek Hesap][Raşit Bankası'nın kredili mevduat hesabı; vadesiz hesaba bağlı kredi limiti (#bkz(<ek-hesap>)).]
#terim[Ek kart][Ana kredi kartına bağlı, harcaması ana kartın limitinden kullanılan kart (#bkz(<ek-kart>)).]
#terim[Ekspertiz][Konutun değerinin bağımsız bir değerleme firmasınca belirlenmesi (#bkz(<konut>)).]
#terim[Ekstre][Kredi kartının bir dönemdeki harcamalarını, borcunu ve son ödeme tarihini gösteren belge (#bkz(<ekstre>)).]
#terim[Erken ödeme tazminatı][Kredinin vadesinden önce ödenen kısmı için alınan tazminat (#bkz(<erken-odeme>)).]
#terim[FAST][Başka bankadaki hesaba 7 gün 24 saat, saniyeler içinde yapılan transfer (#bkz(<fast>)).]
#terim[Fek][İpoteğin tapu kaydından kaldırılması (#bkz(<kredi-kapanis>)).]
#terim[Gecikme faizi][Ödeme gününde ödenmeyen tutara gecikilen gün sayısı kadar uygulanan faiz (#bkz(<gecikme>)).]
#terim[Geçici limit artışı][Kredi kartı limitinin en fazla 30 gün için artırılması (#bkz(<kart-limiti>)).]
#terim[Güvenli ödeme (3D Secure)][İnternet alışverişlerinde işlemin bildirim ya da tek kullanımlık kodla doğrulanması (#bkz(<kart-sifresi>)).]
#terim[Hafta sonu kuru][Piyasaların kapalı olduğu hafta sonu ve resmî tatillerde döviz alım satımında uygulanan, alış-satış farkı geniş kur (#bkz(<doviz-alim>)).]
#terim[Halka arz][Bir şirketin hisselerinin ilk kez borsada satışa sunulması (#bkz(<hisse>)).]
#terim[Havale][Raşit Bankası içindeki hesaplar arasında yapılan transfer (#bkz(<havale>)).]
#terim[Hesap kesim tarihi][Kredi kartı harcamalarının toplanıp ekstrenin düzenlendiği gün (#bkz(<ekstre>)).]
#terim[IBAN][Uluslararası banka hesap numarası. Türkiye'de TR ile başlar ve 26 karakterdir (#bkz(<vadesiz>)).]
#terim[İpotek][Konut kredisinde konutun tapusuna banka lehine konulan teminat kaydı (#bkz(<konut>)).]
#terim[İş günü][Cumartesi, pazar ve resmî tatiller dışındaki günler (#bkz(<ucret-vergi-bicim>)).]
#terim[İştirakli ortak hesap][Para çekme ve transfer için bütün hesap sahiplerinin birlikte onayının gerektiği ortak hesap (#bkz(<ortak-cocuk>)).]
#terim[Kambiyo Muameleleri Vergisi][Döviz ve altın alımlarında alınan vergi (#bkz(<doviz-alim>)).]
#terim[Karekod][TR Karekod standardında, kamerayla okutularak ödeme ve transfer yapılan kod (#bkz(<karekod>)).]
#terim[Kasko][Aracın hasar ve çalınma risklerine karşı yapılan sigorta; taşıt kredisinde zorunludur (#bkz(<kredi-sigorta>)).]
#terim[Kat mülkiyeti][Tamamlanmış ve yapı kullanma izni alınmış bir binadaki bağımsız bölüm üzerindeki mülkiyet; konut kredisi için aranır (#bkz(<konut>)).]
#terim[KKB][Kredi Kayıt Bürosu. Bankaların kredi ve kart ödeme bilgilerini topladığı kuruluş (#bkz(<kredi-sartlar>)).]
#terim[KKDF][Kaynak Kullanımını Destekleme Fonu. Tüketici kredilerinin faizine eklenen fon kesintisi (#bkz(<kredi-faiz-vergi>)).]
#terim[Kolay Adres][IBAN yerine telefon numarası, e-posta adresi ya da T.C. kimlik numarasıyla FAST yapılmasını sağlayan tanım (#bkz(<fast>)).]
#terim[Kredi hayat sigortası][Kredi süresince vefat hâlinde kalan kredi borcunu ödeyen, isteğe bağlı sigorta (#bkz(<kredi-sigorta>)).]
#terim[Kredi notu][KKB'nin ödeme geçmişine göre hesapladığı 1 ile 1.900 arasındaki puan (#bkz(<kredi-sartlar>)).]
#terim[Kredi tahsis ücreti][Kredi kullandırılırken bir kez alınan, kredi tutarının binde 5'i kadar ücret (#bkz(<kredi-faiz-vergi>)).]
#terim[Kumbara hesabı][Faiz kazandıran ve para istenen gün çekilebilen birikim hesabı (#bkz(<kumbara>)).]
#terim[Mirasçılık belgesi][Vefat eden kişinin mirasçılarını ve paylarını gösteren, noterden ya da sulh hukuk mahkemesinden alınan belge (#bkz(<vefat>)).]
#terim[Muaccel][Borcun vadesi beklenmeden tamamının bir anda istenebilir hâle gelmesi (#bkz(<gecikme>)).]
#terim[Muhabir banka][Yurt dışı transferlerde gönderen ve alıcı banka arasında aracılık eden banka (#bkz(<swift>)).]
#terim[Nakit avans][Kredi kartı limitinden nakit para kullanımı (#bkz(<nakit-avans>)).]
#terim[OUR ve SHA][SWIFT'te masrafları kimin ödeyeceğini belirleyen seçenekler (#bkz(<swift>)).]
#terim[Para piyasası fonu][Kısa vadeli ve düşük riskli araçlara yatırım yapan, satış tutarı aynı iş günü hesaba geçen fon (#bkz(<fonlar>)).]
#terim[RaşitPuan][Kredi kartı harcamalarından kazanılan, 1 puanı 1 TL değerindeki puan (#bkz(<rasitpuan>)).]
#terim[Rehin][Taşıt kredisinde aracın trafik kaydına banka lehine konulan teminat kaydı (#bkz(<tasit>)).]
#terim[Sanal kart][İnternet alışverişleri için kullanılan, ana karttan farklı numaralı kart (#bkz(<sanal-kart>)).]
#terim[Son ödeme tarihi][Kredi kartı dönem borcunun ödenmesi gereken son gün; hesap kesim tarihinden 10 gün sonradır (#bkz(<ekstre>)).]
#terim[Sözleşme öncesi bilgi formu][Kredi sözleşmesinden önce verilen, kredinin bütün maliyetlerini gösteren form (#bkz(<kredi-faiz-vergi>)).]
#terim[Stopaj][Faiz ve yatırım gelirlerinden kaynağında kesilen gelir vergisi (#bkz(<stopaj>)).]
#terim[SWIFT (BIC) kodu][Bankaların uluslararası kimlik kodu. Raşit Bankası'nın kodu RSBKTRIS'tir (#bkz(<gelen-swift>)).]
#terim[Takas][Borsada alınan ya da satılan hisse senedi ile paranın el değiştirmesi; işlem gününden 2 iş günü sonra yapılır (#bkz(<hisse>)).]
#terim[Telefon bankacılığı şifresi][Müşteri Hizmetleri'nde kimlik doğrulamak için kullanılan 4 haneli şifre (#bkz(<musteri-hizmetleri>)).]
#terim[Temassız ödeme][Kartın ödeme cihazına yaklaştırılmasıyla yapılan ödeme (#bkz(<temassiz>)).]
#terim[Teselsüllü ortak hesap][Hesap sahiplerinden her birinin tek başına işlem yapabildiği ortak hesap (#bkz(<ortak-cocuk>)).]
#terim[TMSF][Tasarruf Mevduatı Sigorta Fonu. Gerçek kişilerin mevduatını belirlenen tutara kadar güvence altına alan kurum (#bkz(<tmsf>)).]
#terim[Uygunluk testi][Yatırım bilgisini ve risk tercihini ölçen test (#bkz(<yatirim-hesabi>)).]
#terim[Vadeli mevduat][Paranın belirli bir süre bankada tutularak faiz kazandığı hesap (#bkz(<vadeli>)).]
#terim[Vadesiz hesap][Paranın istenen an kullanılabildiği, faiz işlemeyen temel hesap (#bkz(<vadesiz>)).]
#terim[Yabancı para işlem][Yurt dışında ya da yabancı para birimiyle yapılan kart işlemi; kur dönüşümü ve yurt dışı işlem ücreti uygulanır (#bkz(<yurt-disi-kart>)).]
#terim[Yapılandırma][Ödeme güçlüğünde kredi borcunun vadesinin ya da taksitlerinin yeniden düzenlenmesi (#bkz(<yapilandirma>)).]
#terim[Yıllık maliyet oranı][Faiz, vergi ve ücretlerin hepsini içeren, kredinin yıllık toplam maliyeti (#bkz(<kredi-faiz-vergi>)).]
#terim[Yıllık üyelik ücreti][Kredi kartı için her yıl alınan ücret (#bkz(<yillik-ucret>)).]
